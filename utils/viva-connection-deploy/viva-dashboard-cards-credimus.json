              "data": "{\n}",
              "template": "{\n  \"type\": \"AdaptiveCard\",\n  \"$schema\": \"http://adaptivecards.io/schemas/adaptive-card.json\",\n  \"version\": \"1.5\",\n  \"body\": [\n    {\"type\":\"TextBlock\",\"text\":\"Compliance Hub\",\"weight\":\"Bolder\",\"size\":\"Large\",\"wrap\":true},\n    {\"type\":\"TextBlock\",\"text\":\"Your compliance status at a glance\",\"isSubtle\":true,\"spacing\":\"None\",\"wrap\":true},\n    {\"type\":\"ColumnSet\",\"spacing\":\"Medium\",\"columns\":[{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"4 of 6\",\"weight\":\"Bolder\",\"size\":\"ExtraLarge\",\"color\":\"Good\"},{\"type\":\"TextBlock\",\"text\":\"Trainings complete\",\"spacing\":\"None\",\"isSubtle\":true,\"wrap\":true}]},{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"2\",\"weight\":\"Bolder\",\"size\":\"ExtraLarge\",\"color\":\"Attention\"},{\"type\":\"TextBlock\",\"text\":\"Action required\",\"spacing\":\"None\",\"isSubtle\":true,\"wrap\":true}]}]},\n    {\"type\":\"Container\",\"spacing\":\"Medium\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"MANDATORY TRAININGS\",\"weight\":\"Bolder\",\"size\":\"Small\",\"spacing\":\"Medium\"},{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"AML Annual Refresher\",\"wrap\":true}]},{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"✓ Complete\",\"color\":\"Good\",\"weight\":\"Bolder\"}]}]},{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"KYC Procedures Update\",\"wrap\":true}]},{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"✓ Complete\",\"color\":\"Good\",\"weight\":\"Bolder\"}]}]},{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Data Privacy (GDPR)\",\"wrap\":true}]},{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"⏳ In progress\",\"color\":\"Warning\",\"weight\":\"Bolder\"}]}]},{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Market Abuse Regulation\",\"wrap\":true}]},{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"⚠ Overdue\",\"color\":\"Attention\",\"weight\":\"Bolder\"}]}]},{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Sanctions Screening\",\"wrap\":true}]},{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"✓ Complete\",\"color\":\"Good\",\"weight\":\"Bolder\"}]}]},{\"type\":\"ColumnSet\",\"columns\":[{\"type\":\"Column\",\"width\":\"stretch\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"Cybersecurity Awareness\",\"wrap\":true}]},{\"type\":\"Column\",\"width\":\"auto\",\"items\":[{\"type\":\"TextBlock\",\"text\":\"✓ Complete\",\"color\":\"Good\",\"weight\":\"Bolder\"}]}]}]},\n    {\"type\":\"TextBlock\",\"text\":\"QUICK LINKS\",\"weight\":\"Bolder\",\"size\":\"Small\",\"spacing\":\"Large\"},\n    {\"type\":\"ActionSet\",\"actions\":[{\"type\":\"Action.OpenUrl\",\"title\":\"📋 Policy Library\",\"url\":\"https://{fqdn}{site}/policies\"},{\"type\":\"Action.OpenUrl\",\"title\":\"🚨 Report an Incident\",\"url\":\"https://{fqdn}{site}/reporting\"},{\"type\":\"Action.OpenUrl\",\"title\":\"📅 Regulatory Calendar\",\"url\":\"https://{fqdn}{site}/calendar\"}]}\n  ]\n}"
